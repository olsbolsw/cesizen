# Copy to .env.dev for local development.
# NEVER commit .env.prod.
POSTGRES_DB=cesizen
POSTGRES_USER=cesizen
POSTGRES_PASSWORD=dev_password_change_me

# Replace with a long random secret. Your application's JWT property name may differ.
JWT_SECRET=dev_only_change_me_dev_only_change_me_dev_only_change_me_1234567890

# Docker images used by TEST/PROD after GitHub Actions publishes them.
BACKEND_IMAGE=ghcr.io/olsbolsw/cesizen-backend
FRONTEND_IMAGE=ghcr.io/olsbolsw/cesizen-frontend

# DEV does not need this because compose.dev.yaml builds local images.
APP_VERSION=latest
SPRING_PROFILES_ACTIVE=docker
